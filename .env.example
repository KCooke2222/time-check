# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database
# Docker and ./start-dev.sh share one database: the Postgres running on your
# host. There is no bundled database container.
#
# Used when running natively via ./start-dev.sh.
DATABASE_URL=postgresql://your-postgres-user:your-postgres-password@localhost:5432/time_track

# The same database, described in parts for Docker Compose. `localhost` inside a
# container is the container itself, so docker-compose.yml cannot reuse
# DATABASE_URL as-is; it rebuilds the URL from these against
# host.docker.internal. Keep these three in sync with DATABASE_URL — Compose
# fails immediately if any of them is missing.
POSTGRES_USER=your-postgres-user
# The raw password, not percent-encoded: it is substituted into the URL as-is,
# so a password containing a URL-reserved character (@ : / ? #) is not supported
# on the Docker path even though DATABASE_URL can carry it percent-encoded.
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=time_track

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Sync Settings
SYNC_INTERVAL_HOURS=1
SYNC_LOOKBACK_DAYS=7

# CORS (frontend URL)
CORS_ORIGINS=http://localhost:5173

# Where the OAuth callback sends the browser after a successful login.
# Defaults to the first CORS_ORIGINS entry; set this only if the two differ.
# FRONTEND_URL=http://localhost:5173

# Email (weekly report emails; read by backend/config.py)
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-app-password
MAIL_DEFAULT_SENDER=you@example.com
# Defaults shown; override only for a non-Gmail SMTP server
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true

# Gemini API (category matching)
GEMINI_API_KEY=your-gemini-api-key

# Frontend demo mode: 'true' swaps the API client for mock data
VITE_DEMO_MODE=false

# Docker Compose overrides (optional; defaults shown)
#
# FRONTEND_HOST_PORT moves the frontend, as long as CORS_ORIGINS above (or
# FRONTEND_URL) is updated to the new origin — the OAuth callback redirects
# there once login succeeds.
# FRONTEND_HOST_PORT=5173
#
# BACKEND_HOST_PORT cannot actually move the backend on its own: 5000 is also
# hardcoded as the API base URL in frontend/src/services/api.js, and the
# browser makes those calls, so every one of them fails. See README.md.
# BACKEND_HOST_PORT=5000
# Port your host Postgres listens on, if not the default
# POSTGRES_PORT=5432
