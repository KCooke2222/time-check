# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database
# Used when running natively via ./start-dev.sh.
DATABASE_URL=postgresql://

# Docker Compose only: credentials for the bundled `postgres` service.
# docker-compose.yml builds the container-side DATABASE_URL from these and
# points it at the `postgres` service instead of localhost.
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=time_track

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Sync Settings
SYNC_INTERVAL_HOURS=1
SYNC_LOOKBACK_DAYS=7

# CORS (frontend URL)
CORS_ORIGINS=http://localhost:5173

# Gemini API (category matching)
GEMINI_API_KEY=your-gemini-api-key

# Frontend demo mode: 'true' swaps the API client for mock data
VITE_DEMO_MODE=false

# Docker Compose host port overrides (optional; defaults shown)
# FRONTEND_HOST_PORT=5173
# BACKEND_HOST_PORT=5000
# POSTGRES_HOST_PORT=5434
