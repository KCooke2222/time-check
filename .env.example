# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database
# Docker and ./start-dev.sh share one database: the Postgres running on your
# host. There is no bundled database container.
#
# Used when running natively via ./start-dev.sh.
DATABASE_URL=postgresql://

# The same database, described in parts for Docker Compose. `localhost` inside a
# container is the container itself, so docker-compose.yml cannot reuse
# DATABASE_URL as-is; it rebuilds the URL from these against
# host.docker.internal. Keep these three in sync with DATABASE_URL — Compose
# fails immediately if any of them is missing.
POSTGRES_USER=your-postgres-user
# The raw password, not percent-encoded: it is substituted into the URL as-is,
# so a password containing a URL-reserved character (@ : / ? #) is not supported
# on the Docker path even though DATABASE_URL can carry it percent-encoded.
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=time_track

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Sync Settings
SYNC_INTERVAL_HOURS=1
SYNC_LOOKBACK_DAYS=7

# CORS (frontend URL)
CORS_ORIGINS=http://localhost:5173

# Gemini API (category matching)
GEMINI_API_KEY=your-gemini-api-key

# Frontend demo mode: 'true' swaps the API client for mock data
VITE_DEMO_MODE=false

# Docker Compose overrides (optional; defaults shown)
# FRONTEND_HOST_PORT=5173
# Changing this alone breaks the app: the frontend's API base URL is hardcoded
# to http://localhost:5000/api in frontend/src/services/api.js. See README.md.
# BACKEND_HOST_PORT=5000
# Port your host Postgres listens on, if not the default
# POSTGRES_PORT=5432
